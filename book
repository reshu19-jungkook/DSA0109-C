#include <iostream>
#include <string>
using namespace std;

class Book {
private:
    string title;
    string author;
    int pages;

public:
    // Constructor
    Book(string t, string a, int p) {
        title = t;
        author = a;
        pages = p;
        cout << "Book constructor called!" << endl;
    }

    // Destructor
    ~Book() {
        cout << "Book destructor called!" << endl;
    }

    // Display book details
    void display() const {
        cout << "\nBook Details:" << endl;
        cout << "Title : " << title << endl;
        cout << "Author: " << author << endl;
        cout << "Pages : " << pages << endl;
    }
};

int main() {
    Book b1("C++ Programming", "Bjarne Stroustrup", 1200);
    b1.display();

    return 0;
}
