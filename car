#include <iostream>
using namespace std;

class Car {
private:
    string model;

public:
    // Constructor
    Car(string m) {
        model = m;
        cout << "Car constructor called. Model: " << model << endl;
    }

    // Destructor
    ~Car() {
        cout << "Car destructor called. Model: " << model << endl;
    }
};

int main() {
    Car c("Toyota");
    return 0;
}

